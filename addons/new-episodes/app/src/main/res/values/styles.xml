<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Screen" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
    </style>

    <style name="Title">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#FFFFFFFF</item>
        <item name="android:textSize">34sp</item>
    </style>

    <style name="Label">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:letterSpacing">0.2</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">#9EFFFFFF</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="Body">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#C8FFFFFF</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="Small">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#8CFFFFFF</item>
        <item name="android:textSize">15sp</item>
    </style>

    <!-- A pill like the launcher's top bar: glass, white when focused. -->
    <style name="Action">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:background">@drawable/action_background</item>
        <item name="android:minWidth">120dp</item>
        <item name="android:paddingStart">22dp</item>
        <item name="android:paddingEnd">22dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/action_text</item>
        <item name="android:textSize">16sp</item>
    </style>
</resources>
